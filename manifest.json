{
  "manifest_version": 3,
  "name": "Gerenciador de URLs",
  "version": "1.2",
  "description": "Gerencie URLs com Bruno Pereira",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gerenciador de URLs"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}